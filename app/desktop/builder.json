{
  "appId": "in.chausar.desktop", "productName": "Chausar Preview",
  "directories": { "output": "release" }, "asar": true, "forceCodeSigning": true, "electronLanguages": ["en-US", "en-GB", "hi"],
  "files": ["app/desktop/**/*", "platform/runtime/venture/models/credential-contract.cjs", "app/ui/dist/**/*", "!app/ui/src/**/*", "!app/ui/tests/**/*", "!app/ui/public/**/*", "!app/ui/assets/**/*", "!app/ui/node_modules/**/*", "!app/ui/index.html", "!app/ui/README.md", "!app/ui/tsconfig.json", "!app/ui/vite.config.ts", "!app/ui/vitest.config.ts", "!app/desktop/icons/icon.icns", { "from": "app/engine/dist", "to": "app/engine/dist", "filter": ["**/*"] }, "scripts/postgres-runtime.mjs", "package.json", "node_modules/**/*", "!node_modules/@anthropic-ai/claude-agent-sdk-*/**"],
  "asarUnpack": ["package.json", "node_modules/**/*", "scripts/postgres-runtime.mjs", "app/engine/dist/**/*"],
  "extraResources": [{ "from": "runtime-binaries", "to": "runtime-binaries", "filter": ["**/*"] }, { "from": "vendor/feedback/feedback.json", "to": "feedback.json" }],
  "win": { "target": ["nsis"], "signAndEditExecutable": true, "icon": "app/desktop/icons/icon.ico" },
  "mac": { "target": ["dmg"], "hardenedRuntime": true, "icon": "app/desktop/icons/icon.icns" },
  "linux": { "target": ["AppImage"], "category": "Office", "icon": "app/desktop/icons/png" },
  "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "installerIcon": "app/desktop/icons/icon.ico", "uninstallerIcon": "app/desktop/icons/icon.ico" },
  "publish": null
}
