{
  "appId": "in.chausar.desktop", "productName": "Chausar Preview",
  "directories": { "output": "release" }, "asar": true, "forceCodeSigning": true,
  "files": ["app/**/*", "platform/runtime/**/*", "platform/helpers/**/*", "scripts/postgres-runtime.mjs", "fixtures/**/*", "package.json", "node_modules/pg/**/*", "node_modules/pg-*/**/*", "node_modules/postgres-*/**/*", "node_modules/xtend/**/*", "node_modules/@duckdb/**/*"],
  "asarUnpack": ["node_modules/**/*", "platform/runtime/**/*", "platform/helpers/**/*", "scripts/postgres-runtime.mjs"],
  "extraResources": [{ "from": "runtime-binaries", "to": "runtime-binaries", "filter": ["**/*"] }],
  "win": { "target": ["nsis"], "signAndEditExecutable": true },
  "mac": { "target": ["dmg"], "hardenedRuntime": true },
  "linux": { "target": ["AppImage"], "category": "Office" },
  "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true },
  "publish": null
}
