{
  "appId": "in.chausar.desktop.preview",
  "productName": "Chausar Unsigned Preview",
  "artifactName": "Chausar-Preview-${version}-${os}-${arch}.${ext}",
  "directories": {
    "output": "release/preview"
  },
  "asar": true,
  "forceCodeSigning": false,
  "npmRebuild": false,
  "electronLanguages": [
    "en-US",
    "en-GB",
    "hi"
  ],
  "extraMetadata": {
    "name": "chausar-preview",
    "chausarPreview": true,
    "chausarReleaseChannel": "unsigned-preview"
  },
  "files": [
    "app/desktop/**/*",
    "app/ui/dist/**/*",
    "!app/ui/src/**/*",
    "!app/ui/tests/**/*",
    "!app/ui/public/**/*",
    "!app/ui/assets/**/*",
    "!app/ui/node_modules/**/*",
    "!app/ui/index.html",
    "!app/ui/README.md",
    "!app/ui/tsconfig.json",
    "!app/ui/vite.config.ts",
    "!app/ui/vitest.config.ts",
    "!app/desktop/icons/icon.icns",
    {
      "from": "app/engine/dist",
      "to": "app/engine/dist",
      "filter": [
        "**/*"
      ]
    },
    "platform/runtime/venture/models/credential-contract.cjs",
    "scripts/postgres-runtime.mjs",
    "package.json",
    "node_modules/**/*",
    "!node_modules/@anthropic-ai/claude-agent-sdk-*/**"
  ],
  "asarUnpack": [
    "package.json",
    "node_modules/**/*",
    "scripts/postgres-runtime.mjs",
    "app/engine/dist/**/*"
  ],
  "extraResources": [],
  "win": {
    "target": [
      "zip"
    ],
    "signAndEditExecutable": false,
    "icon": "app/desktop/icons/icon.ico"
  },
  "mac": {
    "target": [
      "dmg",
      "zip"
    ],
    "identity": null,
    "hardenedRuntime": false,
    "notarize": false,
    "icon": "app/desktop/icons/icon.icns"
  },
  "linux": {
    "target": [
      "AppImage",
      "tar.gz"
    ],
    "category": "Office",
    "icon": "app/desktop/icons/png"
  },
  "publish": null,
  "electronDist": "node_modules/electron/dist",
  "afterPack": "./scripts/desktop-after-pack.cjs"
}
