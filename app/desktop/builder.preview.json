{
  "appId": "in.chausar.desktop.preview",
  "productName": "Chausar Unsigned Preview",
  "artifactName": "Chausar-Preview-${version}-${os}-${arch}.${ext}",
  "directories": {
    "output": "release/preview"
  },
  "asar": true,
  "forceCodeSigning": false,
  "npmRebuild": false,
  "extraMetadata": {
    "name": "chausar-preview",
    "chausarPreview": true,
    "chausarReleaseChannel": "unsigned-preview"
  },
  "files": [
    "app/desktop/**/*",
    "app/ui/dist/**/*",
    "!app/ui/src/**/*",
    "!app/ui/tests/**/*",
    "!app/ui/public/**/*",
    "!app/ui/assets/**/*",
    "!app/ui/node_modules/**/*",
    "!app/ui/index.html",
    "!app/ui/README.md",
    "!app/ui/tsconfig.json",
    "!app/ui/vite.config.ts",
    "!app/ui/vitest.config.ts",
    "platform/runtime/**/*",
    "platform/semantic-qualification/src/**/*",
    "platform/semantic-qualification/package.json",
    "platform/helpers/**/*",
    "scripts/postgres-runtime.mjs",
    "fixtures/**/*",
    "package.json",
    "node_modules/**/*"
  ],
  "asarUnpack": [
    "package.json",
    "node_modules/**/*",
    "platform/runtime/**/*",
    "platform/semantic-qualification/src/**/*",
    "platform/semantic-qualification/package.json",
    "platform/helpers/**/*",
    "scripts/postgres-runtime.mjs"
  ],
  "extraResources": [],
  "win": {
    "target": [
      "zip"
    ],
    "signAndEditExecutable": false
  },
  "mac": {
    "target": [
      "dmg",
      "zip"
    ],
    "identity": null,
    "hardenedRuntime": false,
    "notarize": false
  },
  "linux": {
    "target": [
      "AppImage",
      "tar.gz"
    ],
    "category": "Office"
  },
  "publish": null,
  "electronDist": "node_modules/electron/dist"
}
