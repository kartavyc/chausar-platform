{
  "appId": "in.chausar.desktop",
  "productName": "Chausar",
  "artifactName": "Chausar-Beta-${version}-${os}-${arch}.${ext}",
  "asar": true,
  "forceCodeSigning": false,
  "npmRebuild": false,
  "electronLanguages": [
    "en-US",
    "en-GB",
    "hi"
  ],
  "extraMetadata": {
    "name": "chausar",
    "productName": "Chausar",
    "chausarReleaseChannel": "beta",
    "homepage": "https://www.chausar.co.in"
  },
  "files": [
    "app/desktop/**/*",
    "app/ui/dist/**/*",
    "!app/ui/src/**/*",
    "!app/ui/tests/**/*",
    "!app/ui/public/**/*",
    "!app/ui/assets/**/*",
    "!app/ui/node_modules/**/*",
    "!app/ui/index.html",
    "!app/ui/README.md",
    "!app/ui/tsconfig.json",
    "!app/ui/vite.config.ts",
    "!app/ui/vitest.config.ts",
    "!app/desktop/icons/icon.icns",
    {
      "from": "app/engine/dist",
      "to": "app/engine/dist",
      "filter": [
        "**/*"
      ]
    },
    "platform/runtime/venture/models/credential-contract.cjs",
    "scripts/postgres-runtime.mjs",
    "package.json",
    "node_modules/**/*",
    "!node_modules/@anthropic-ai/claude-agent-sdk-*/**"
  ],
  "asarUnpack": [
    "package.json",
    "node_modules/**/*",
    "scripts/postgres-runtime.mjs",
    "app/engine/dist/**/*"
  ],
  "extraResources": [
    {
      "from": "vendor/codex-bundle/${os}-${arch}",
      "to": "codex",
      "filter": [
        "**/*"
      ]
    },
    {
      "from": "app/desktop/notices",
      "to": "notices",
      "filter": [
        "**/*"
      ]
    },
    {
      "from": "LICENSE",
      "to": "LICENSE"
    },
    {
      "from": "NOTICE",
      "to": "NOTICE"
    },
    {
      "from": "vendor/feedback/feedback.json",
      "to": "feedback.json"
    }
  ],
  "win": {
    "target": [
      "nsis"
    ],
    "signAndEditExecutable": false,
    "icon": "app/desktop/icons/icon.ico"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowElevation": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Chausar",
    "deleteAppDataOnUninstall": false,
    "runAfterFinish": true,
    "include": "app/desktop/installer.nsh",
    "installerIcon": "app/desktop/icons/icon.ico",
    "uninstallerIcon": "app/desktop/icons/icon.ico"
  },
  "linux": {
    "target": [
      "deb",
      "AppImage",
      "tar.gz"
    ],
    "category": "Office",
    "executableName": "chausar",
    "icon": "app/desktop/icons/png"
  },
  "deb": {
    "maintainer": "Kartavy Chauhan <info@chausar.co.in>"
  },
  "publish": null,
  "electronDist": "node_modules/electron/dist",
  "afterPack": "./scripts/desktop-after-pack.cjs"
}
