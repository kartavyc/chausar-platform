        {
          "assertionId": "RZP-ORDER-PAID-IS-NOT-NET-RECEIPTS",
          "status": "unqualified",
          "referenceIds": [
            "REF-RAZORPAY-ORDER-V1"
          ],
          "evidenceBasis": "documented-behavior",
          "fieldPaths": [
            "Order.status",
            "Order.amount_paid",
            "Order.amount_due"
          ],
          "trap": "Order paid state persists after an associated payment refund.",
          "requiredGuard": {
            "guardId": "separate-order-status-from-cash",
            "parameters": {
              "forbiddenSoleEvidence": [
                "Order.status=paid"
              ],
              "requiredReceiptKinds": [
                "captured-payment",
                "linked-refund"
              ],
              "sourceTotalReconciliationRequired": true
            },
            "enforcement": "deterministic-required",
            "onUnimplemented": "abstain",
            "onMissingEvidence": "abstain",
            "onContradictoryProfile": "invalidate"
          },
          "positiveAndNegativeCases": "required-not-yet-vendor-qualified"
        },
        {
          "assertionId": "RZP-REFUND-FINAL-STATE-AND-IDENTITY",
          "status": "unqualified",
          "referenceIds": [
            "REF-RAZORPAY-REFUND-V1"
          ],
          "evidenceBasis": "documented-behavior",
          "fieldPaths": [
            "Refund.id",
            "Refund.payment_id",
            "Refund.status",
            "Refund.amount",
            "Refund.currency"
          ],
          "trap": "Pending or failed refund is not the documented processed state.",
          "requiredGuard": {
            "guardId": "linked-refund-state",
            "parameters": {
              "acceptedRefundState": "processed",
              "nonFinalStates": [
                "pending"
              ],
              "failedStates": [
                "failed"
              ],
              "unknownState": "abstain",
              "requirePaymentLink": true,
              "amountUnit": "currency-subunit"
            },
            "enforcement": "deterministic-required",
            "onUnimplemented": "abstain",
            "onMissingEvidence": "abstain",
            "onContradictoryProfile": "invalidate"
          },
          "positiveAndNegativeCases": "required-not-yet-vendor-qualified"
