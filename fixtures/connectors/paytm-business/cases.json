    }
  },
  {
    "name": "report total that does not match",
    "recipe": "paytm.settlements",
    "file": "settlements-sep-2026.csv",
    "reportTotals": {
      "rowCount": 3,
      "total": "415000"
    },
    "expect": {
      "status": "refused",
      "code": "SOURCE_TOTAL_MISMATCH"
    }
  }
