{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "ignoreUnknown": true,
    "includes": ["platform/**", "app/**", "scripts/**", "!**/fixtures", "!**/node_modules", "!**/dist", "!**/release", "!**/data", "!**/vaults"]
  },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 160, "lineEnding": "auto" },
  "linter": { "enabled": false },
  "assist": { "enabled": false },
  "javascript": {
    "formatter": { "quoteStyle": "single", "jsxQuoteStyle": "double", "semicolons": "always", "trailingCommas": "all", "arrowParentheses": "asNeeded", "quoteProperties": "preserve" }
  },
  "json": { "formatter": { "enabled": false } },
  "css": { "formatter": { "enabled": false } }
}
