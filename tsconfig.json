{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "esModuleInterop": true
  },
  "include": [
    "platform/runtime/**/*.ts",
    "platform/tests/**/*.ts",
    "platform/semantic-qualification/src/**/*.ts",
    "platform/semantic-qualification/tests/**/*.ts",
    "platform/semantic-qualification/run-suite.ts",
    "app/desktop/**/*.ts",
    "app/desktop/**/*.cts"
  ]
}
