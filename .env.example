# Generated by scripts/env-docs.mjs from platform/runtime/config/env.ts. Edit that list, then run node scripts/env-docs.mjs --write.
# The variables someone running Chausar from source may set. All are optional; docs/configuration.md lists every one.
# A data folder must be an absolute path outside the code folder. Secrets are never written here: supply them at run time.

# Set to off to stop the automatic encrypted backups of each business. Unset: automatic backups are on.
CHAUSAR_AUTO_BACKUPS=

# The folder that holds the per-platform browser sign-in profiles. Unset: ~/.chausar/browser-sessions.
CHAUSAR_BROWSER_PROFILES=

# Set to pending to turn the Claude Code way off until its terms are accepted. Unset: Claude Code is available.
CHAUSAR_CLAUDE_CODE_TERMS=

# Set to none to keep vault keys out of the computer's protected storage and ask for a passphrase instead. Unset: the computer's protected storage keeps each vault key.
CHAUSAR_DEVICE_KEYS=

# The data home: a local server or worker keeps its data in CHAUSAR_HOME/<kind>. Unset: the per-user folder (on Windows %LOCALAPPDATA%\Chausar\dev\<kind>).
CHAUSAR_HOME=

# The local web server's port. Unset: 4317.
CHAUSAR_PORT=

# The local server's PostgreSQL address, for real (non-demo) storage. Unset: real storage cannot start; the demo uses file storage.
CHAUSAR_POSTGRES_URL=

# The Python the analytics helper runs with. Unset: the desktop sets its bundled Python; the local server finds none.
CHAUSAR_PYTHON=

# Where test receipts, perf budgets and the screenshot walk write. Unset: <temp>/chausar-runs/<date>-<name>.
CHAUSAR_RUN_ROOT=

# The publisher's PEM public key that update feeds are checked against; never taken from a model. Unset: updates are not checked or offered.
CHAUSAR_UPDATE_PUBLIC_KEY=

# The folder that holds the business vaults; the desktop sets it to its own user data folder. Unset: the data home (CHAUSAR_HOME/<kind>, else the per-user folder); a hand-started worker refuses.
CHAUSAR_VAULT_DIRECTORY=
