# Production never silently falls back to demo/file storage.
CHAUSAR_STORAGE=postgres
# Local-only PostgreSQL URL. Supply credentials through your own runtime secret store.
CHAUSAR_POSTGRES_URL=postgresql://chausar:REPLACE_ME@127.0.0.1:5432/chausar
CHAUSAR_VAULT_DIRECTORY=./vaults
CHAUSAR_PORT=4317
# API route credentials are supplied at runtime, never committed.
OPENAI_API_KEY=
CHAUSAR_PYTHON=
# Publisher-owned PEM public key supplied by deployment; never accept it from a model.
CHAUSAR_UPDATE_PUBLIC_KEY=
