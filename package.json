{
  "name": "chausar-desktop",
  "version": "0.1.0-preview.1",
  "private": true,
  "description": "Local business intelligence: every number has a receipt.",
  "type": "module",
  "main": "app/desktop/main.cjs",
  "engines": {
    "node": ">=24.13.1"
  },
  "scripts": {
    "start": "node platform/runtime/server.ts --demo",
    "start:production": "node platform/runtime/server.ts",
    "desktop": "node scripts/desktop-launch.mjs --demo",
    "test": "node --experimental-vm-modules --test platform/tests/*.test.ts",
    "check": "node scripts/check.mjs",
    "typecheck": "tsc --noEmit",
    "verify": "node scripts/check.mjs && node --experimental-vm-modules --test platform/tests/*.test.ts",
    "build": "node scripts/build.mjs",
    "build:ui-host": "node scripts/build-ui-host.mjs",
    "package": "node scripts/desktop-package.mjs --mode final",
    "bench": "node scripts/bench.mjs",
    "desktop:production": "node scripts/desktop-launch.mjs --production",
    "desktop:ui-preview": "node scripts/desktop-launch.mjs --demo --ui-preview",
    "desktop:check": "node scripts/desktop-launch.mjs --demo --check",
    "desktop:smoke": "node scripts/desktop-smoke.mjs",
    "package:preview": "node scripts/desktop-package.mjs --mode preview",
    "package:check": "node scripts/desktop-package.mjs --mode preview --check",
    "phone:preview": "node scripts/phone-web-preview.mjs",
    "typecheck:phone": "tsc --noEmit --project app/companion/tsconfig.portable.json",
    "typecheck:ui": "tsc --noEmit --project app/ui/tsconfig.json",
    "test:ui": "node --test app/ui/tests/*.test.ts && vitest run --config frontend-validation/vitest.config.mjs"
  },
  "dependencies": {
    "pg": "8.23.0",
    "@duckdb/node-api": "1.5.5-r.3"
  },
  "devDependencies": {
    "electron": "44.4.5",
    "electron-builder": "26.0.12",
    "typescript": "5.9.3",
    "@types/node": "24.0.0",
    "@types/pg": "8.15.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-aria-components": "1.22.1",
    "react-intl": "12.1.4",
    "vite": "8.3.4",
    "vitest": "5.0.3",
    "@vitejs/plugin-react": "6.1.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "jsdom": "30.1.2",
    "postcss": "8.5.30",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0"
  }
}
